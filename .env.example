# Klipin Music Environment Variables Template

# Server & Ports
PORT=8000
KLIPIN_MUSIC_PUBLIC_API_URL=http://localhost:8002

# AI Cover Engine (SheetSage2 + YuE2)
# Options: yue2_comfy (Recommended for VRAM 6-8GB) or yue2_native (VRAM 16-24GB)
COVER_ENGINE=yue2_comfy
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=600
MAX_DURATION=360
KLIPIN_YUE2_COMFY_ENABLED=1
KLIPIN_YUE2_NATIVE_ENABLED=0
SHEETSAGE2_MODEL_PATH=m-a-p/SheetSage2
YUE2_MODEL_PATH=m-a-p/YuE2-3B

# Optional External Keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Modal Serverless GPU Workers
KLIPIN_HEARTMULA_MODAL_ENABLED=1
KLIPIN_MULACOVER_MODAL_ENABLED=1
KLIPIN_DIFFRHYTHM_MODAL_ENABLED=1
KLIPIN_ACE_STEP_MODAL_ENABLED=1
KLIPIN_VOICE_MODAL_ENABLED=1
